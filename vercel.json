{
  "buildCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then npx convex deploy && npm run build; else npm run build; fi",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/|assets/|icons/|manifest\\.webmanifest|sw\\.js|favicon).*)",
      "destination": "/index.html"
    }
  ]
}
